APP_NAME=RekaCy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default: SQLite (no server needed, file: database/database.sqlite)
DB_CONNECTION=sqlite

# To use MySQL instead (e.g. XAMPP), replace the line above with:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rekacy
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@rekacy.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- RekaCy group scenario (change per group / during the code interview) ---
REKACY_TIMEZONE=Asia/Jakarta
REKACY_DEMO_DATA=true
REKACY_GROUP="Group A"
REKACY_GROUP_ROUTE="Southeast Asia → Europe"
REKACY_GROUP_EXCEPTION=CUSTOMS_HOLD
REKACY_GROUP_KPI="On-time delivery rate"
DELAY_LOW_MAX_HOURS=6
DELAY_MEDIUM_MAX_HOURS=24
DELAY_THRESHOLD_HOURS=12
REKACY_MAIL_NOTIFICATIONS=false

# --- External APIs (no key required; never commit real keys) ---
GEOCODING_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT="RekaCy-UAS/1.0 (your-email@example.com)"
WEATHER_URL=https://api.open-meteo.com/v1/forecast

# --- Real-time (Laravel Reverb WebSocket) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=100001
REVERB_APP_KEY=rekacy-local-key
REVERB_APP_SECRET=rekacy-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
